#!name = Bilibili Accelerator Core
#!desc = Rewrite slow Bilibili PCDN/MCDN media URLs and add official CDN fallbacks.
#!author = realzza
#!homepage = https://github.com/wyyadd/bilibili-accelerator
#!version = __VERSION__
#!select = baEnabled,true,false
#!select = baMode,bad-only,force,off
#!select = baSelection,auto,fixed
#!select = baPcdnHost,upos-sz-mirrorcos.bilivideo.com,upos-sz-mirrorali.bilivideo.com,upos-sz-mirrorhw.bilivideo.com,upos-tf-all-hw.bilivideo.com,upos-tf-all-tx.bilivideo.com
#!select = baMcdnStrategy,proxy-all,proxy-v1,replace
#!select = baRewriteAkamai,false,true
#!select = baPortHeuristic,true,false

[General]
force-http-engine-hosts = *.bilivideo.com, *.bilivideo.cn, *.bilivideo.net, *.szbdyd.com, *.mountaintoys.cn, *.nexusedgeio.com, *.ahdohpiechei.com, *:4480, *:4483, *:8000, *:8082, *:9102

[Script]
http-request ^https?:\/\/[^\/]*(?:bilivideo\.(?:com|cn|net)|akamaized\.net|szbdyd\.com|mountaintoys\.cn|nexusedgeio\.com|ahdohpiechei\.com|(?:\d{1,3}\.){3}\d{1,3})(?::\d+)?\/ script-path=https://wyyadd.github.io/bilibili-accelerator/app/bilibili-accelerator.request.js, tag=Bilibili Accelerator media request, enable=true
http-response ^https?:\/\/api\.bilibili\.com\/(?:x\/player\/(?:wbi\/)?playurl|pgc\/player\/(?:web|api)\/(?:v2\/)?playurl) script-path=https://wyyadd.github.io/bilibili-accelerator/app/bilibili-accelerator.response.js, tag=Bilibili Accelerator playurl response, requires-body=true, timeout=10, enable=true
http-response ^https?:\/\/api\.live\.bilibili\.com\/xlive\/.*getRoomPlayInfo script-path=https://wyyadd.github.io/bilibili-accelerator/app/bilibili-accelerator.response.js, tag=Bilibili Accelerator live response, requires-body=true, timeout=10, enable=true
cron "*/10 * * * *" script-path=https://wyyadd.github.io/bilibili-accelerator/app/bilibili-accelerator.rank.js, tag=Bilibili Accelerator CDN rank, timeout=10, enable=true

[MITM]
hostname = api.bilibili.com, api.live.bilibili.com, *.bilivideo.com, *.bilivideo.cn, *.bilivideo.net, upos-*-mirrorakam.akamaized.net, *.szbdyd.com, *.mountaintoys.cn, *.nexusedgeio.com, *.ahdohpiechei.com
