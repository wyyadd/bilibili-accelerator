#!name = Bilibili Accelerator
#!desc = Rewrite slow Bilibili PCDN/MCDN media URLs and add official CDN fallbacks.
#!author = wyyadd
#!homepage = https://github.com/wyyadd/bilibili-accelerator
#!version = __VERSION__
#!loon_version = 3.2.1(733)

[Argument]
mode = select,"bad-only","force","off",tag=改写模式,desc=bad-only 仅处理慢速 CDN；force 处理所有识别到的点播 CDN；off 关闭改写

[General]
force-http-engine-hosts = *.bilivideo.com, *.bilivideo.cn, *.bilivideo.net, *.szbdyd.com, *.mountaintoys.cn, *.nexusedgeio.com, *.ahdohpiechei.com, *:4480, *:4483, *:8000, *:8082, *:9102

[Script]
http-request ^https?:\/\/[^\/]*(?:bilivideo\.(?:com|cn|net)|akamaized\.net|szbdyd\.com|mountaintoys\.cn|nexusedgeio\.com|ahdohpiechei\.com|(?:\d{1,3}\.){3}\d{1,3})(?::\d+)?\/ script-path=https://wyyadd.github.io/bilibili-accelerator/app/bilibili-accelerator.request.js, argument=[{mode}], tag=Bilibili Accelerator media request, enable=true
http-response ^https?:\/\/api\.bilibili\.com\/(?:x\/player\/(?:wbi\/)?playurl|pgc\/player\/(?:web|api)\/(?:v2\/)?playurl) script-path=https://wyyadd.github.io/bilibili-accelerator/app/bilibili-accelerator.response.js, argument=[{mode}], tag=Bilibili Accelerator playurl response, requires-body=true, timeout=10, enable=true
http-response ^https?:\/\/api\.live\.bilibili\.com\/xlive\/.*getRoomPlayInfo script-path=https://wyyadd.github.io/bilibili-accelerator/app/bilibili-accelerator.response.js, argument=[{mode}], tag=Bilibili Accelerator live response, requires-body=true, timeout=10, enable=true
cron "*/10 * * * *" script-path=https://wyyadd.github.io/bilibili-accelerator/app/bilibili-accelerator.rank.js, argument=[{mode}], tag=Bilibili Accelerator CDN rank, timeout=10, enable=true

[MITM]
hostname = api.bilibili.com, api.live.bilibili.com, *.bilivideo.com, *.bilivideo.cn, *.bilivideo.net, upos-*-mirrorakam.akamaized.net, *.szbdyd.com, *.mountaintoys.cn, *.nexusedgeio.com, *.ahdohpiechei.com
